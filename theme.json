{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "880px",
      "wideSize": "1280px"
    },
    "color": {
      "palette": [
        {
          "slug": "primary",
          "name": "Primary",
          "color": "#253E5B"
        },
        {
          "slug": "secondary",
          "name": "Secondary",
          "color": "#A76D4B"
        },
        {
          "slug": "soft",
          "name": "Soft",
          "color": "#F5F1EB"
        },
        {
          "slug": "white",
          "name": "White",
          "color": "#ffffff"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw"
      ]
    },
    "typography": {
      "fluid": false
    }
  },
  "styles": {
    "typography": {
      "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontWeight": "760",
          "lineHeight": "1.1"
        }
      }
    }
  }
}
